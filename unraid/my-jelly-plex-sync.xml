<?xml version="1.0"?>
<Container version="2">
  <Name>jelly-plex-sync</Name>
  <Repository>ghcr.io/paulg67/jelly-plex-sync:latest</Repository>
  <Registry>https://ghcr.io/paulg67/jelly-plex-sync</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/PaulG67/jelly-plex-sync/issues</Support>
  <Project>https://github.com/PaulG67/jelly-plex-sync</Project>
  <Overview>Lokaler Watch-Status-Sync zwischen Plex und Jellyfin. Dry-Run-Ergebnisse und Sync-Aktionen unter http://UNRAID-IP:8787. Nicht ins Internet freigeben.</Overview>
  <Category>MediaApp:Other Status:Beta</Category>
  <WebUI>http://[IP]:[PORT:8787]/WebUI>
  <TemplateURL>https://raw.githubusercontent.com/PaulG67/jelly-plex-sync/main/unraid/my-jelly-plex-sync.xml</TemplateURL>
  <Icon>https://cdn.jsdelivr.net/gh/selfhst/icons/png/jellyfin.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <GitHub>https://github.com/PaulG67/jelly-plex-sync</GitHub>
  <Date>1755360000</Date>
  <Beta>False</Beta>
  <Requires/>
  <Config Name="Plex URL" Target="PLEX_BASEURL" Default="http://172.17.0.1:32400" Mode="" Description="Nur LAN/Docker-Host, nicht das Internet. 172.17.0.1 ist der Unraid-Host aus dem Bridge-Netz." Type="Variable" Display="always" Required="true" Mask="false">http://172.17.0.1:32400</Config>
  <Config Name="Jellyfin URL" Target="JELLYFIN_BASEURL" Default="http://172.17.0.1:8096" Mode="" Description="Nur LAN/Docker-Host, nicht das Internet." Type="Variable" Display="always" Required="true" Mask="false">http://172.17.0.1:8096</Config>
  <Config Name="Jellyfin Benutzer" Target="JELLYFIN_USERNAME" Default="" Mode="" Description="Lokaler Jellyfin-Benutzer. Kein API-Key nötig. Passwort nur setzen, wenn der User eines hat." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Jellyfin Passwort" Target="JELLYFIN_PASSWORD" Default="" Mode="" Description="Leer lassen, wenn der Jellyfin-User kein Passwort hat. Bleibt lokal im Container." Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Plex Token (optional)" Target="PLEX_TOKEN" Default="" Mode="" Description="Leer lassen, wenn Plex-Appdata gemountet ist. Token wird aus Preferences.xml gelesen." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Jellyfin API Key (optional)" Target="JELLYFIN_TOKEN" Default="" Mode="" Description="Nur falls kein Benutzername genutzt wird." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="User Mapping" Target="USER_MAPPING" Default="" Mode="" Description="PlexName=JellyfinName, weitere Paare per Komma" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Library Mapping" Target="LIBRARY_MAPPING" Default="" Mode="" Description="Optional: Movies=Filme,TV Shows=Serien" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Sleep Duration" Target="SLEEP_DURATION" Default="300" Mode="" Description="Sekunden zwischen Sync-Läufen" Type="Variable" Display="always" Required="false" Mask="false">300</Config>
  <Config Name="Dry Run" Target="DRY_RUN" Default="true" Mode="" Description="true = nur anzeigen, nichts schreiben. Ergebnis in der Web-UI." Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Web UI" Target="WEB_ENABLED" Default="true" Mode="" Description="Lokale Übersicht der Sync-/Dry-Run-Aktionen" Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Web Port" Target="WEB_PORT" Default="8787" Mode="" Description="Interner Port der Web-UI" Type="Variable" Display="advanced" Required="false" Mask="false">8787</Config>
  <Config Name="WebUI Port" Target="8787" Default="8787" Mode="tcp" Description="Nur LAN. Nicht am Router freigeben." Type="Port" Display="always" Required="false" Mask="false">8787</Config>
  <Config Name="Plex to Jellyfin" Target="SYNC_FROM_PLEX_TO_JELLYFIN" Default="true" Mode="" Description="Watch-Status von Plex nach Jellyfin" Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Jellyfin to Plex" Target="SYNC_FROM_JELLYFIN_TO_PLEX" Default="true" Mode="" Description="Watch-Status von Jellyfin nach Plex" Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Sync Watched" Target="SYNC_WATCHED" Default="true" Mode="" Description="Gesehen-Status synchronisieren" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Sync Progress" Target="SYNC_PROGRESS" Default="true" Mode="" Description="Resume-Position synchronisieren" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Sync New Items" Target="SYNC_NEW_ITEMS" Default="true" Mode="" Description="Neue Titel einbeziehen" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Watched Percent" Target="WATCHED_PERCENT" Default="90" Mode="" Description="Ab diesem Fortschritt als gesehen" Type="Variable" Display="advanced" Required="false" Mask="false">90</Config>
  <Config Name="Log Level" Target="LOG_LEVEL" Default="INFO" Mode="" Description="INFO oder DEBUG" Type="Variable" Display="advanced" Required="false" Mask="false">INFO</Config>
  <Config Name="SSL Bypass" Target="SSL_BYPASS" Default="false" Mode="" Description="true bei selbstsignierten Zertifikaten" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/jelly-plex-sync" Mode="rw" Description="Persistenter State" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/jelly-plex-sync</Config>
  <Config Name="Plex Appdata (read-only)" Target="/plex" Default="/mnt/user/appdata/plex" Mode="ro" Description="Plex-Appdata. Daraus wird der lokale Token gelesen, kein Key eintippen." Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/plex</Config>
</Container>
