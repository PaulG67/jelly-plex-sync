<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>jelly-plex-sync</Name>
  <Repository>ghcr.io/paulg67/jelly-plex-sync:latest</Repository>
  <Registry>https://ghcr.io/paulg67/jelly-plex-sync</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/PaulG67/jelly-plex-sync/issues</Support>
  <Project>https://github.com/PaulG67/jelly-plex-sync</Project>
  <Overview>Lokaler Watch-Status-Sync zwischen Plex und Jellyfin. Dry-Run unter http://UNRAID-IP:8787. Nicht ins Internet freigeben.</Overview>
  <Category>MediaApp:Other Status:Beta</Category>
  <WebUI>http://[IP]:[PORT:8787]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/PaulG67/jelly-plex-sync/main/unraid/my-jelly-plex-sync.xml</TemplateURL>
  <Icon>https://cdn.jsdelivr.net/gh/selfhst/icons/png/jellyfin.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <Date>2026-08-16</Date>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/jelly-plex-sync" Mode="rw" Description="Persistenter State der Sync-App" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/jelly-plex-sync</Config>
  <Config Name="Plex Appdata" Target="/plex" Default="/mnt/user/appdata/plex" Mode="ro" Description="Plex Appdata Ordner read-only. Token wird lokal gelesen." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/plex</Config>
  <Config Name="WebUI Port" Target="8787" Default="8787" Mode="tcp" Description="Nur LAN. Nicht am Router freigeben." Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="Plex URL" Target="PLEX_BASEURL" Default="http://172.17.0.1:32400" Mode="" Description="Plex URL auf dem Unraid Host" Type="Variable" Display="always" Required="true" Mask="false">http://172.17.0.1:32400</Config>
  <Config Name="Jellyfin URL" Target="JELLYFIN_BASEURL" Default="http://172.17.0.1:8096" Mode="" Description="Jellyfin URL auf dem Unraid Host" Type="Variable" Display="always" Required="true" Mask="false">http://172.17.0.1:8096</Config>
  <Config Name="Jellyfin Benutzer" Target="JELLYFIN_USERNAME" Default="" Mode="" Description="Lokaler Jellyfin Benutzername" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Jellyfin Passwort" Target="JELLYFIN_PASSWORD" Default="" Mode="" Description="Leer lassen wenn kein Passwort" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="User Mapping" Target="USER_MAPPING" Default="" Mode="" Description="Nur wenn Namen unterschiedlich: PlexName=JellyfinName" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Sleep Duration" Target="SLEEP_DURATION" Default="300" Mode="" Description="Sekunden zwischen Sync-Laeufen" Type="Variable" Display="always" Required="false" Mask="false">300</Config>
  <Config Name="Dry Run" Target="DRY_RUN" Default="true" Mode="" Description="true = nur anzeigen, nichts schreiben. Ergebnis in der Web-UI." Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Web UI" Target="WEB_ENABLED" Default="true" Mode="" Description="Lokale Uebersicht der Sync-Aktionen" Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Plex to Jellyfin" Target="SYNC_FROM_PLEX_TO_JELLYFIN" Default="true" Mode="" Description="Sync von Plex nach Jellyfin" Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Jellyfin to Plex" Target="SYNC_FROM_JELLYFIN_TO_PLEX" Default="true" Mode="" Description="Sync von Jellyfin nach Plex" Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Plex Token optional" Target="PLEX_TOKEN" Default="" Mode="" Description="Nur wenn Appdata-Mount nicht reicht" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Jellyfin API Key optional" Target="JELLYFIN_TOKEN" Default="" Mode="" Description="Nur ohne Benutzername" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Library Mapping" Target="LIBRARY_MAPPING" Default="" Mode="" Description="Optional: Movies=Filme" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Web Port Env" Target="WEB_PORT" Default="8787" Mode="" Description="Interner Web Port" Type="Variable" Display="advanced" Required="false" Mask="false">8787</Config>
  <Config Name="Sync Watched" Target="SYNC_WATCHED" Default="true" Mode="" Description="Gesehen-Status sync" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Sync Progress" Target="SYNC_PROGRESS" Default="true" Mode="" Description="Resume-Position sync" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Sync New Items" Target="SYNC_NEW_ITEMS" Default="true" Mode="" Description="Neue Titel einbeziehen" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Watched Percent" Target="WATCHED_PERCENT" Default="90" Mode="" Description="Ab diesem Fortschritt als gesehen" Type="Variable" Display="advanced" Required="false" Mask="false">90</Config>
  <Config Name="Log Level" Target="LOG_LEVEL" Default="INFO" Mode="" Description="INFO oder DEBUG" Type="Variable" Display="advanced" Required="false" Mask="false">INFO</Config>
  <Config Name="SSL Bypass" Target="SSL_BYPASS" Default="false" Mode="" Description="true bei selbstsignierten Zertifikaten" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
</Container>
